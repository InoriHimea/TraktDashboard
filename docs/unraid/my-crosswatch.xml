<?xml version="1.0"?>
<Container version="2">
  <Name>crosswatch</Name>
  <Repository>ghcr.io/cenodude/crosswatch:latest</Repository>
  <Registry>https://github.com/cenodude/CrossWatch</Registry>
  <Network>br0</Network>
  <MyIP>10.100.121.137</MyIP>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/cenodude/CrossWatch/issues</Support>
  <Project>https://github.com/cenodude/CrossWatch</Project>
  <Overview>CrossWatch media synchronization engine. Synchronize Jellyfin, Plex, Emby, Trakt, SIMKL and other media providers. Uses a local SQLite database and JSON/config files under /config; it does not require PostgreSQL. This template uses br0 macvlan with fixed IP 10.100.121.137.</Overview>
  <Category>MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/cenodude/CrossWatch/main/docs/unraid/my-crosswatch.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/cenodude/CrossWatch/main/docs/images/providers/CROSSWATCH.svg</Icon>
  <ExtraParams>--label=net.unraid.docker.managed=dockerman --label=org.opencontainers.image.title=CrossWatch --label=org.opencontainers.image.source=https://github.com/cenodude/CrossWatch --label=org.opencontainers.image.licenses=AGPL-3.0</ExtraParams>
  <PostArgs/>
  <DateInstalled>1788015600</DateInstalled>
  <Config Name="Web UI Port" Target="8787" Default="8787" Mode="tcp" Description="CrossWatch web UI and API port" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/crosswatch" Mode="rw" Description="Persistent CrossWatch configuration, local tracker database, provider state and snapshots" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/crosswatch</Config>
  <Config Name="Timezone" Target="TZ" Default="Asia/Shanghai" Mode="" Description="Container timezone" Type="Variable" Display="always" Required="true" Mask="false">Asia/Shanghai</Config>
  <TailscaleStateDir/>
</Container>
